# Aura Engine — Environment Variables
# Copy this to .env and fill in your values.
#
# When AURA_AUTH_TOKEN is empty, WebSocket connections are only allowed from localhost.
# Set a token to accept remote connections (provide ?token=<YOUR_TOKEN> on connect).

# Bind address
AURA_HOST=127.0.0.1

# Listen port
AURA_PORT=8000

# Logging level (debug, info, warning, error)
AURA_LOG_LEVEL=info

# WebSocket auth token — empty = localhost only
AURA_AUTH_TOKEN=

# Max WebSocket message size in bytes (64KB default)
AURA_MAX_WS_MESSAGE_BYTES=65536

# Max render text length in characters
AURA_MAX_RENDER_CHARS=5000

# SQLite database path (:memory: for ephemeral, or a file path)
AURA_DB_PATH=:memory:
