# Aura Engine — Environment Configuration
# Copy to .env and fill in values

# Hermes Agent connection
HERMES_API_KEY=HERMES...n
# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Arabic rendering
ARABIC_FONT_PATH=/usr/share/fonts/truetype/noto/NotoNaskhArabic-Regular.ttf
DEFAULT_FONT_SIZE=28
MAX_RENDER_WIDTH=576
MAX_RENDER_HEIGHT=288

# WebSocket
WS_MAX_MESSAGE_SIZE=65536
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# Session store (SQLite)
SESSION_DB_PATH=./data/aura_sessions.db

# CORS (for companion app)
CORS_ORIGINS=*
